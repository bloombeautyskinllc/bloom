# Copy to .env.local for local development. On Vercel, set these per environment
# (Development / Preview / Production). Never commit real values.

# Public URL of this deployment (used in emails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Local stack: `npx supabase start` prints these (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (Web application). Also read by supabase/config.toml for the local stack
# (put these two in supabase/.env as well) and configured in Supabase > Auth > Providers > Google.
# Authorized redirect URIs in Google Cloud: <supabase url>/auth/v1/callback (sign-in) and
# <site url>/api/google/callback (Google Calendar connection).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (bloombeautyskinllc.com)
EMAIL_FROM="BLOOM Beauty Skin <hello@bloombeautyskinllc.com>"

# Comma-separated emails that receive the admin role when they sign in
ADMIN_EMAILS=

# Shared secret for internal job endpoints (pg_cron -> /api/jobs/run). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBS_SECRET=

# Resend delivery webhook signing secret (whsec_...): Resend > Webhooks > https://<site>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# --- Later phases ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN=
